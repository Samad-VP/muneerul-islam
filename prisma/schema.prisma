generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  password          String
  role              String     @default("admin")
  avatar            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  familyId          String?
  auditLogs         AuditLog[]
  expensesApproved  Expense[]  @relation("ApprovedExpenses")
  expensesRequested Expense[]  @relation("RequestedExpenses")
  family            Family?    @relation(fields: [familyId], references: [id])
}

model Mahallu {
  id            String         @id @default(cuid())
  name          String
  arabicName    String?
  address       String?
  district      String?
  panchayat     String?
  pincode       String?
  phone         String?
  email         String?
  president     String?
  secretary     String?
  imam          String?
  established   String?
  logo          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  committees    Committee[]
  events        Event[]
  families      Family[]
}

model Family {
  id               String   @id @default(cuid())
  familyNumber     String   @unique
  houseName        String
  houseNumber      String?
  address          String?
  ward             String?
  phone            String?
  rationCardNo     String?
  annualIncome     String?
  monthlyDueAmount Float    @default(0)
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mahalluId        String
  mahallu          Mahallu  @relation(fields: [mahalluId], references: [id], onDelete: Cascade)
  incomes          Income[]
  members          Member[]
  users            User[]

  @@index([mahalluId])
  @@index([familyNumber])
}

model Member {
  id                   String            @id @default(cuid())
  name                 String
  arabicName           String?
  relationToHead       String
  gender               String
  dob                  DateTime?
  age                  Int?
  maritalStatus        String?
  phone                String?
  email                String?
  bloodGroup           String?
  education            String?
  educationDetail      String?
  occupation           String?
  occupationDetail     String?
  monthlyIncome        String?
  abroad               Boolean           @default(false)
  abroadCountry        String?
  healthIssues         String?
  disabilities         String?
  isAlive              Boolean           @default(true)
  isVoter              Boolean           @default(false)
  voterIdNo            String?
  aadhaarNo            String?
  photo                String?
  remarks              String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  familyId             String
  committeeMemberships CommitteeMember[]
  incomes              Income[]
  family               Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([name])
}

model Committee {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  mahalluId   String
  mahallu     Mahallu           @relation(fields: [mahalluId], references: [id], onDelete: Cascade)
  members     CommitteeMember[]

  @@index([mahalluId])
}

model CommitteeMember {
  id          String    @id @default(cuid())
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  isActive    Boolean   @default(true)
  memberId    String
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, committeeId])
  @@index([memberId])
  @@index([committeeId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  venue       String?
  type        String?
  status      String    @default("upcoming")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mahalluId   String
  mahallu     Mahallu   @relation(fields: [mahalluId], references: [id], onDelete: Cascade)

  @@index([mahalluId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  String   @default("normal")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mahalluId String
  mahallu   Mahallu  @relation(fields: [mahalluId], references: [id], onDelete: Cascade)

  @@index([mahalluId])
}

model Fund {
  id          String    @id @default(cuid())
  name        String    @unique
  type        String    @default("general")
  description String?
  balance     Float     @default(0)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
  incomes     Income[]
}

model Income {
  id           String    @id @default(cuid())
  receiptNo    String    @unique
  amount       Float
  isMonthlyDue Boolean   @default(false)
  month        Int?
  year         Int?
  status       String    @default("PAID")
  notes        String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  fundId       String
  familyId     String?
  memberId     String?
  family       Family?   @relation(fields: [familyId], references: [id])
  fund         Fund      @relation(fields: [fundId], references: [id])
  member       Member?   @relation(fields: [memberId], references: [id])

  @@index([fundId])
  @@index([familyId])
  @@index([receiptNo])
}

model Expense {
  id            String   @id @default(cuid())
  voucherNo     String   @unique
  title         String
  description   String?
  amount        Float
  status        String   @default("PENDING_APPROVAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fundId        String
  requestedById String
  approvedById  String?
  approvedBy    User?    @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  fund          Fund     @relation(fields: [fundId], references: [id])
  requestedBy   User     @relation("RequestedExpenses", fields: [requestedById], references: [id])

  @@index([fundId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  oldData    String?
  newData    String?
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}
